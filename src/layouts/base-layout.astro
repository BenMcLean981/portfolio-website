---
import { Colophon } from '../components/book/colophon';
import { NavBar } from '../components/nav/navbar';
import { readBuildInfo } from '../lib/build-info/build-info';
import { canonicalUrl } from '../lib/seo/canonical-url';
import '../styles/globals.css';

type Props = {
  title?: string;
};

const { title = 'Ben McLean | Full Stack Developer' } = Astro.props;

const { buildHash } = readBuildInfo(process.env);
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {
      Astro.site && (
        <link rel="canonical" href={canonicalUrl(Astro.url.pathname, Astro.site)} />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="min-h-screen">
    <div class="mx-auto max-w-[72rem] px-6 sm:px-10 lg:px-16">
      <header class="border-b border-rule">
        <NavBar client:load />
      </header>
      <main class="py-12 lg:py-20">
        <slot />
      </main>
      <footer class="border-t border-rule py-10">
        <Colophon buildHash={buildHash} builtOn={new Date()} />
      </footer>
    </div>
  </body>
</html>
