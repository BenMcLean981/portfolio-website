---
import { NavBar } from '../components/nav/navbar';
import { TitleBlock } from '../components/sheet/title-block';
import { readBuildInfo } from '../lib/build-info/build-info';
import { canonicalUrl } from '../lib/seo/canonical-url';
import '../styles/globals.css';

type Props = {
  title?: string;
  // Each page is a sheet in the set; the title block at the bottom names it.
  sheet: { title: string; number?: number };
};

const { title = 'Ben McLean | Full Stack Developer', sheet } = Astro.props;

const { buildHash } = readBuildInfo(process.env);
const revision = buildHash?.slice(0, 7) ?? 'local';
const builtOn = new Date().toISOString().slice(0, 10);
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {
      Astro.site && (
        <link rel="canonical" href={canonicalUrl(Astro.url.pathname, Astro.site)} />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="min-h-screen p-2 sm:p-5">
    <div class="relative mx-auto max-w-[80rem]">
      <svg
        class="pointer-events-none absolute inset-0 h-full w-full overflow-visible text-ink"
        aria-hidden="true"
      >
        <rect
          class="plot"
          x="0"
          y="0"
          width="100%"
          height="100%"
          pathLength="1"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"></rect>
      </svg>
      <div class="relative m-2 sm:m-3">
        <svg
          class="pointer-events-none absolute inset-0 h-full w-full overflow-visible text-ink"
          aria-hidden="true"
        >
          <rect
            class="plot plot-late"
            x="0"
            y="0"
            width="100%"
            height="100%"
            pathLength="1"
            fill="none"
            stroke="currentColor"
            stroke-width="0.75"></rect>
        </svg>
        <header class="relative border-b border-construction">
          <NavBar client:load />
        </header>
        <main class="relative px-5 py-10 sm:px-10 lg:px-14 lg:py-14">
          <slot />
        </main>
        <footer
          class="relative flex flex-col-reverse gap-6 border-t border-construction px-5 py-6 sm:px-10 lg:flex-row lg:items-end lg:justify-between lg:px-14"
        >
          <p class="max-w-[46ch] text-sm text-ink-soft">
            The views expressed on this website are mine alone and do not
            necessarily reflect the views of my employer.
          </p>
          <TitleBlock
            title={sheet.title}
            sheetNumber={sheet.number}
            sheetCount={4}
            revision={revision}
            date={builtOn}
          />
        </footer>
      </div>
    </div>
  </body>
</html>
