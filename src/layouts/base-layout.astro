---
import { Font } from 'astro:assets';
import { ViewsDisclaimer } from '../components/disclaimer/views-disclaimer';
import { SiteFooter } from '../components/footer/site-footer';
import { NavBar } from '../components/nav/navbar';
import { readBuildInfo } from '../lib/build-info/build-info';
import { getCanonicalUrl } from '../lib/seo/canonical-url';
import { listMetaTags, type ArticleDates } from '../lib/seo/list-meta-tags';
import '../styles/globals.css';

type Props = {
  title?: string;
  description: string;
  article?: ArticleDates;
};

const {
  title = 'Ben McLean | Full Stack Developer',
  description,
  article,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const canonicalUrl = getCanonicalUrl(Astro.url.pathname, site);
const metaTags = listMetaTags({
  title,
  description,
  url: canonicalUrl,
  imageUrl: new URL('/images/portrait.jpg', site).href,
  article,
});

const { buildHash } = readBuildInfo(process.env);
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d2023" />
    <Font cssVariable="--font-figtree" preload />
    <title>{title}</title>
    {metaTags.map((tag) => <meta {...tag} />)}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ben McLean"
      href="/blog/rss.xml"
    />
  </head>
  <body class="min-h-screen">
    <header
      class="sticky top-0 z-40 border-b border-line bg-nav shadow-[0_10px_24px_-18px_rgb(0_0_0/0.6)]"
    >
      <div class="mx-auto max-w-[68rem] px-6">
        <NavBar client:load />
      </div>
    </header>
    <main class="mx-auto max-w-[68rem] px-6 pt-6 pb-16">
      <div class="mb-8">
        <ViewsDisclaimer />
      </div>
      <slot />
    </main>
    <footer class="mx-auto max-w-[68rem] px-6 pb-12">
      <div class="border-t border-line pt-8">
        <SiteFooter buildHash={buildHash} />
      </div>
    </footer>
  </body>
</html>
