---
import { NavBar } from '../components/nav/navbar';
import '../styles/globals.css';

type Props = {
  title?: string;
};

const { title = 'Ben McLean | Full Stack Developer' } = Astro.props;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16" />
  </head>
  <body class="antialiased dark:bg-slate-900 mb-48">
    <header>
      <NavBar client:load />
    </header>
    <div class="my-2">
      <div class="xl:mx-48 lg:mx-36 md:mx-12 sm:mx-6 mx-4">
        <slot />
      </div>
    </div>
  </body>
</html>
