---
import { NavBar } from '../components/nav/navbar';
import { readBuildInfo } from '../lib/build-info/build-info';
import { canonicalUrl } from '../lib/seo/canonical-url';
import '../styles/globals.css';

type Props = {
  title?: string;
};

const { title = 'Ben McLean | Full Stack Developer' } = Astro.props;

const { buildHash } = readBuildInfo(process.env);
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {
      Astro.site && (
        <link rel="canonical" href={canonicalUrl(Astro.url.pathname, Astro.site)} />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="min-h-screen">
    <div class="mx-auto max-w-[84rem] px-3 sm:px-6">
      <header>
        <NavBar client:load />
      </header>
      <main>
        <slot />
      </main>
      <footer
        class="flex flex-col gap-2 py-8 font-[family-name:var(--font-condensed)] text-base text-edge-soft sm:flex-row sm:justify-between"
      >
        <p>
          The views expressed on this website are mine alone and do not
          necessarily reflect the views of my employer.
        </p>
        <p>{buildHash ? `Built from commit ${buildHash.slice(0, 7)}` : 'Local build'}</p>
      </footer>
    </div>
  </body>
</html>
